---
interface Props {
  n: number
}

const { n } = Astro.props
---

<div class="md-line group flex min-h-6.5 font-mono text-sm leading-6.5">
  <span
    class="md-gutter w-12 shrink-0 select-none border-r border-(--editor-border) bg-(--editor-gutter-bg) pr-3 text-right text-(--editor-gutter)"
    aria-hidden="true"
  >
    {n}
  </span>
  <div class="md-content min-w-0 flex-1 wrap-break-words px-4 whitespace-pre-wrap">
    <slot />
  </div>
</div>
