---
interface Props {
  n?: number
}

const { n = 1 } = Astro.props
---

<div class="md-line group flex min-h-6.5 font-mono text-sm leading-6.5">
  <span
    class="md-gutter w-12 shrink-0 select-none border-r border-(--editor-border) bg-(--editor-gutter-bg) pr-3 text-right text-(--editor-gutter)"
    aria-hidden="true"
  >
    {n}
  </span>
  <div class="md-content min-w-0 flex-1 px-4 py-3">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-6">
      <div class="shrink-0 space-y-2">
        <img
          src="/me.png"
          alt="Ravi Mistry"
          class="h-64 rounded-lg border border-(--editor-border) object-cover"
        />
        <p class="max-w-36 break-all text-sm leading-snug">
          <span
            class="md-marker">(</span
          ><span class="md-link-url">/me.png</span><span class="md-marker">)</span>
        </p>
      </div>

      <div class="min-w-0 flex-1 space-y-0 wrap-break-words">
        <p>
          <span class="md-h1"># </span><span class="md-heading md-h1">Ravi Mistry</span>
        </p>
        <p class="h-6.5">&nbsp;</p>
        <p>
          <span class="md-italic-marker">*</span><span class="md-italic">Software Engineer</span><span
            class="md-italic-marker">*</span
          >
        </p>
        <p class="h-6.5">&nbsp;</p>
        <p>
          <span class="md-text"
            >Building scalable backend systems, real-time applications, and AI-powered products with a focus on clean architecture and thoughtful engineering.</span
          >
        </p>
      </div>
    </div>
  </div>
</div>
