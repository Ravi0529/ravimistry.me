---
import MarkdownEditorLayout from "@/layouts/MarkdownEditorLayout.astro";
import MdLine from "@/components/markdown-editor/MdLine.astro";
---

<MarkdownEditorLayout
  title="Resume | Ravi Mistry"
  description="Download or view my resume online."
  activeFile="RESUME.md"
>
  <div class="py-1">
    <MdLine n={1}>
      <span class="md-h1"># </span><span class="md-heading md-h1">Resume</span>
    </MdLine>
    <MdLine n={2} />
    <MdLine n={3}>
      <span class="md-text"
        >You can view or download my resume from the link below:</span
      >
    </MdLine>
    <MdLine n={4} />
    <MdLine n={5}>
      <span class="md-marker">- </span><span class="md-bold-marker">**</span
      ><span class="md-bold">Resume</span><span class="md-bold-marker">:**</span
      >
      <span class="md-text"> </span>
      <span class="md-marker">[</span>
      <a
        href="https://drive.google.com/file/d/19NZqUrAi3PPQISeW_2WtbgmsvU7kGtOl/view?usp=drive_link"
        class="md-link-text"
        target="_blank"
        rel="noreferrer">View Resume (Google Drive)</a
      >
      <span class="md-marker">](</span>
      <span class="md-link-url"
        >https://drive.google.com/file/d/19NZqUrAi3PPQISeW_2WtbgmsvU7kGtOl/view?usp=drive_link</span
      >
      <span class="md-marker">)</span>
    </MdLine>
    <MdLine n={6} />
    <MdLine n={7}>
      <span class="md-hr">---</span>
    </MdLine>
    <MdLine n={8} />
    <MdLine n={9}>
      <span class="md-text">You can also view the embedded preview below:</span>
    </MdLine>
    <MdLine n={10} />
    <MdLine n={11}>
      <div class="resume-embed">
        <iframe
          src="https://drive.google.com/file/d/19NZqUrAi3PPQISeW_2WtbgmsvU7kGtOl/preview"
          width="100%"
          height="600"
          allow="autoplay"
          class="rounded-lg border border-zinc-200 dark:border-zinc-700"
        ></iframe>
      </div>
    </MdLine>
    <MdLine n={12} />
    <MdLine n={13}>
      <span class="md-hr">---</span>
    </MdLine>
    <MdLine n={14} />
    <MdLine n={15}>
      <span class="md-text"
        >For a quick summary of my experience, skills, and projects, check out
        the
      </span>
      <span class="md-marker">[</span>
      <a href="/" class="md-link-text">About Me</a>
      <span class="md-marker">](</span>
      <span class="md-link-url">/</span>
      <span class="md-marker">)</span>
      <span class="md-text"> page.</span>
    </MdLine>
    <MdLine n={16} />
  </div>
</MarkdownEditorLayout>
