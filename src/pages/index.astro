---
import MarkdownEditorLayout from "@/layouts/MarkdownEditorLayout.astro";
import MdHero from "@/components/markdown-editor/MdHero.astro";
import MdLine from "@/components/markdown-editor/MdLine.astro";
---

<MarkdownEditorLayout
  title="Ravi Mistry | Software Engineer"
  description="Building scalable backend systems, real-time applications, and AI-powered products with a focus on clean architecture and thoughtful engineering."
  activeFile="ME.md"
>
  <div class="py-1">
    <MdHero />

    <MdLine n={2} />
    <MdLine n={3}>
      <span class="md-h2">## </span><span class="md-heading md-h2"
        >Education</span
      >
    </MdLine>
    <MdLine n={4} />
    <MdLine n={5}>
      <span class="md-bold-marker">**</span><span class="md-bold"
        >Gujarat Technological University</span
      ><span class="md-bold-marker">**</span>
    </MdLine>
    <MdLine n={6}>
      <span class="md-text"
        >Bachelor in Computer Engineering — Surat, Gujarat, India</span
      >
    </MdLine>
    <MdLine n={7}>
      <span class="md-meta">July 2023 – July 2027</span>
    </MdLine>
    <MdLine n={8} />

    <MdLine n={9}>
      <span class="md-h2">## </span><span class="md-heading md-h2"
        >About Me</span
      >
    </MdLine>
    <MdLine n={10} />
    <MdLine n={11}>
      <span class="md-text"
        >I'm a software engineer who enjoys building products that are
        practical, scalable and solve real-world problems. I like taking ideas
        from concept to deployment, whether it's a full-stack web application, a
        backend service, a real-time platform or an AI-powered solution. My
        approach to development focuses on writing clean, maintainable code
        while continuously learning new technologies and engineering practices.</span
      >
    </MdLine>
    <MdLine n={12} />

    <MdLine n={13}>
      <span class="md-h3">### </span><span class="md-heading md-h3"
        >What I work on</span
      >
    </MdLine>
    <MdLine n={14} />
    <MdLine n={15}>
      <span class="md-marker">- </span><span class="md-text"
        >Full-Stack Web Development using modern JavaScript and TypeScript
        ecosystems.</span
      >
    </MdLine>
    <MdLine n={16}>
      <span class="md-marker">- </span><span class="md-text"
        >Backend Engineering with REST APIs, databases, authentication and
        scalable architectures.</span
      >
    </MdLine>
    <MdLine n={17}>
      <span class="md-marker">- </span><span class="md-text"
        >Real-Time Applications using WebSockets, Socket.IO and event-driven
        systems.</span
      >
    </MdLine>
    <MdLine n={18}>
      <span class="md-marker">- </span><span class="md-text"
        >Generative AI applications using LLMs, RAG pipelines, AI agents and
        workflow automation.</span
      >
    </MdLine>
    <MdLine n={19}>
      <span class="md-marker">- </span><span class="md-text"
        >Machine Learning fundamentals including data preprocessing, model
        training and evaluation.</span
      >
    </MdLine>
    <MdLine n={20}>
      <span class="md-marker">- </span><span class="md-text"
        >Cybersecurity fundamentals with experience from an internship focused
        on Information Security Education &amp; Awareness and practical
        Generative AI applications.</span
      >
    </MdLine>
    <MdLine n={21}>
      <span class="md-marker">- </span><span class="md-text"
        >Cloud, Docker, databases and deployment workflows for modern
        applications.</span
      >
    </MdLine>
    <MdLine n={22}>
      <span class="md-marker">- </span><span class="md-text"
        >Data Structures &amp; Algorithms in C++ to continuously strengthen
        problem-solving and software engineering fundamentals.</span
      >
    </MdLine>
    <MdLine n={23} />
    <MdLine n={24}>
      <span class="md-text"
        >I enjoy exploring how different technologies work together to build
        reliable software and I'm always looking for opportunities to
        collaborate, contribute to open source and build products that make a
        real impact.</span
      >
    </MdLine>
    <MdLine n={25} />

    <MdLine n={26}>
      <span class="md-h2">## </span><span class="md-heading md-h2"
        >Technical Stack</span
      >
    </MdLine>
    <MdLine n={27} />
    <MdLine n={28}>
      <span class="md-marker">- </span><span class="md-bold-marker">**</span
      ><span class="md-bold">Languages</span><span class="md-bold-marker"
        >:**</span
      ><span class="md-text"> C, C++, Java, JavaScript, TypeScript, SQL, Python, Astro</span>
    </MdLine>
    <MdLine n={29}>
      <span class="md-marker">- </span><span class="md-bold-marker">**</span
      ><span class="md-bold">Frontend</span><span class="md-bold-marker"
        >:**</span
      ><span class="md-text"> React.js, Next.js, Tailwind CSS, Astro</span>
    </MdLine>
    <MdLine n={30}>
      <span class="md-marker">- </span><span class="md-bold-marker">**</span
      ><span class="md-bold">Backend</span><span class="md-bold-marker"
        >:**</span
      ><span class="md-text"> Node.js, Express.js, FastAPI, Python, REST APIs</span>
    </MdLine>
    <MdLine n={31}>
      <span class="md-marker">- </span><span class="md-bold-marker">**</span
      ><span class="md-bold">Databases</span><span class="md-bold-marker"
        >:**</span
      ><span class="md-text"> PostgreSQL, MongoDB, MySQL, VectorDB</span>
    </MdLine>
    <MdLine n={32}>
      <span class="md-marker">- </span><span class="md-bold-marker">**</span
      ><span class="md-bold">Cloud</span><span class="md-bold-marker">:**</span
      ><span class="md-text"> Linux, Git, GitHub, Docker, Vercel</span>
    </MdLine>
    <MdLine n={33}>
      <span class="md-marker">- </span><span class="md-bold-marker">**</span
      ><span class="md-bold">AI &amp; ML</span><span class="md-bold-marker"
        >:**</span
      ><span class="md-text"> Numpy, Pandas, Matplotlib, Scikit-learn</span
      >
    </MdLine>
    <MdLine n={34}>
      <span class="md-marker">- </span><span class="md-bold-marker">**</span
      ><span class="md-bold">Generative AI</span><span class="md-bold-marker"
        >:**</span
      ><span class="md-text"> LangChain, LangGraph, Inngest, Hugging Face, OpenAI SDK, OpenRouter</span
      >
    </MdLine>
    <MdLine n={35}>
      <span class="md-marker">- </span><span class="md-bold-marker">**</span
      ><span class="md-bold">Real-Time</span><span class="md-bold-marker"
        >:**</span
      ><span class="md-text"> WebSockets, Socket.IO, Kafka, Redis</span>
    </MdLine>
    <MdLine n={36} />

    <MdLine n={37}>
      <span class="md-h2">## </span><span class="md-heading md-h2">Open To</span
      >
    </MdLine>
    <MdLine n={38} />
    <MdLine n={39}>
      <span class="md-marker">- </span><span class="md-text"
        >Software Engineering Internships</span
      >
    </MdLine>
    <MdLine n={40}>
      <span class="md-marker">- </span><span class="md-text"
        >Open Source Collaboration</span
      >
    </MdLine>
    <MdLine n={41}>
      <span class="md-marker">- </span><span class="md-text">Hackathons</span>
    </MdLine>
    <MdLine n={42}>
      <span class="md-marker">- </span><span class="md-text"
        >Building cool things with great people</span
      >
    </MdLine>
    <MdLine n={43} />

    <MdLine n={44}>
      <span class="md-hr">---</span>
    </MdLine>
    <MdLine n={45} />
    <MdLine n={46}>
      <span class="md-text"
        >If you've made it this far, thanks for reading.</span
      >
    </MdLine>
    <MdLine n={47} />
    <MdLine n={48}>
      <span class="md-text"
        >Feel free to explore the projects, read the blogs, or reach out—I'm
        always happy to connect with people who enjoy building great software.</span
      >
    </MdLine>
    <MdLine n={49} />
  </div>
</MarkdownEditorLayout>
