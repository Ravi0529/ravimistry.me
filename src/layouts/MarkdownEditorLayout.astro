---
import "../styles/global.css"
import { MarkdownEditorShell } from "@/components/markdown-editor/MarkdownEditorShell"

interface Props {
  title: string
  description?: string
  activeFile: string
}

const { title, description, activeFile } = Astro.props
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body class="min-h-screen bg-background font-mono text-foreground antialiased">
    <main class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
      <MarkdownEditorShell activeFile={activeFile} client:load>
        <slot />
      </MarkdownEditorShell>
    </main>
  </body>
</html>
